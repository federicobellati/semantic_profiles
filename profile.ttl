    prof:isProfileOf <http://www.opengis.net/ont/geosparql#> ;
    dcterms:conformsTo <https://www.w3.org/TR/vocab-ssn/> ;
    dcterms:conformsTo <https://www.ogc.org/standards/geosparql/> ;
    prof:hasResource <.../location/1.0.0/> ;
    prof:hasResource <.../thing/1.0.0/> ;
    prof:hasResource <.../sensor/1.0.0/> ;
    prof:hasResource <.../datastream/1.0.0/> ;
    prof:hasResource <.../featureOfInterest/1.0.0/> .
